.PHONY: host up inventory down verify

host:
	./scripts/host-bootstrap.sh

up: host
	cd terraform && terraform init && terraform apply -auto-approve
	$(MAKE) inventory
	cd ansible && ansible-galaxy collection install -r requirements.yml && ansible-playbook site.yml

# Regenerate the Ansible inventory from Terraform output.
inventory:
	@ip="$$(terraform -chdir=terraform output -raw vm_ip)" && \
	printf '# Generated by `make inventory` from terraform output; do not edit.\n[rke2_servers]\n%s\n' "$$ip" > ansible/inventory.ini
	@cat ansible/inventory.ini

down:
	cd terraform && terraform destroy -auto-approve
	rm -f ansible/inventory.ini ansible/.known_hosts

verify:
	kubectl --kubeconfig kubeconfig get nodes -o wide
