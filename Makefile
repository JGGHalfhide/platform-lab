.PHONY: host up inventory down verify argocd bench stig-scan image policy-test \
	rehearsal airgap-stage airgap-packages airgap-up airgap-disconnect airgap-reconnect \
	airgap-deploy airgap-verify etcd-snapshot etcd-snapshots backup-store \
	airgap-link-status airgap-link-share airgap-link-cut airgap-link-uncut etcd-restore \
	vm-start vm-stop

# Node NIC and its reserved DHCP address (host-bootstrap reserves the address,
# Terraform sets the MAC). registry.platform-lab.internal resolves to NODE_IP.
NODE_MAC ?= 52:54:00:70:6c:01
NODE_IP  ?= 192.168.122.10
export NODE_MAC NODE_IP
export TF_VAR_mac_address := $(NODE_MAC)

# Airgap rehearsal VM (stand-in for the iMac; docs/airgap-runbook.md). Kept
# whenever it is already in the Terraform state, so `make up` (which applies
# with -auto-approve) never plans to destroy it.
REHEARSAL_MAC ?= 52:54:00:70:6c:02
REHEARSAL_IP  ?= 192.168.122.20
AIRGAP_REHEARSAL ?= $(shell terraform -chdir=terraform state list 2>/dev/null | grep -q '^module.airgap_rehearsal' && echo true || echo false)
export TF_VAR_airgap_rehearsal := $(AIRGAP_REHEARSAL)
export TF_VAR_rehearsal_mac_address := $(REHEARSAL_MAC)

# The airgapped node (the iMac) for the inventory; defaults to the rehearsal
# VM's address when that VM exists.
AIRGAP_IP ?=

host:
	./scripts/host-bootstrap.sh

# The lab VMs run one at a time (scripts/vm-power.sh): up refuses while the
# rehearsal VM runs, and starts the build VM if it is shut off.
BUILD_VM ?= build-node-01
REHEARSAL_VM ?= airgap-rehearsal

up: host
	./scripts/vm-power.sh check $(BUILD_VM)
	cd terraform && terraform init && terraform apply -auto-approve
	./scripts/vm-power.sh start $(BUILD_VM)
	$(MAKE) inventory
	cd ansible && ansible-galaxy collection install -r requirements.yml && ansible-playbook site.yml --limit build_servers
	$(MAKE) argocd

# Regenerate the Ansible inventory from Terraform output (and AIRGAP_IP).
# The IP outputs come from DHCP leases and are null while a VM is shut off
# (VMs run one at a time); fall back to the reserved addresses then.
inventory:
	@ip="$$(terraform -chdir=terraform output -raw vm_ip 2>/dev/null || true)" && \
	if [ -z "$$ip" ]; then ip="$(NODE_IP)"; fi && \
	aip="$(AIRGAP_IP)" && \
	if [ -z "$$aip" ]; then aip="$$(terraform -chdir=terraform output -raw rehearsal_ip 2>/dev/null || true)"; fi && \
	if [ -z "$$aip" ] && [ "$(AIRGAP_REHEARSAL)" = true ]; then aip="$(REHEARSAL_IP)"; fi && \
	{ printf '# Generated by `make inventory` from terraform output; do not edit.\n'; \
	  printf '[build_servers]\n%s\n\n[airgap_servers]\n' "$$ip"; \
	  [ -z "$$aip" ] || printf '%s\n' "$$aip"; \
	  printf '\n[rke2_servers:children]\nbuild_servers\nairgap_servers\n'; } > ansible/inventory.ini
	@cat ansible/inventory.ini

down:
	cd terraform && terraform destroy -auto-approve
	rm -f ansible/inventory.ini ansible/.known_hosts

verify:
	kubectl --kubeconfig kubeconfig get nodes -o wide

# Switch VMs: make vm-stop VM=build-node-01 && make vm-start VM=airgap-rehearsal.
# start refuses while another lab VM runs or the host lacks the memory.
vm-start:
	@test -n "$(VM)" || { echo "usage: make vm-start VM=<name>"; exit 1; }
	./scripts/vm-power.sh start $(VM)

vm-stop:
	@test -n "$(VM)" || { echo "usage: make vm-stop VM=<name>"; exit 1; }
	./scripts/vm-power.sh stop $(VM)

# Install Argo CD (pinned in gitops/argocd) and the app-of-apps root.
# Idempotent; after this, Argo CD manages itself and everything in gitops/apps/.
argocd:
	kubectl --kubeconfig kubeconfig apply --server-side --force-conflicts -k gitops/argocd
	kubectl --kubeconfig kubeconfig -n argocd rollout status deploy/argocd-server --timeout=300s
	kubectl --kubeconfig kubeconfig -n argocd rollout status deploy/argocd-repo-server --timeout=300s
	kubectl --kubeconfig kubeconfig apply --server-side -f gitops/root.yaml

# kube-bench (RKE2 CIS 1.9) as a one-shot Job; OUT sets the report path.
bench:
	./scripts/kube-bench.sh $(OUT)

# OpenSCAP STIG scan of the node; reports to docs/scans/$(NAME).{html,xml}.
# Only the .gz copies are committed (raw files are ~27 MB per scan).
# LIMIT=airgap_servers scans the airgapped node.
NAME ?= stig-scan
LIMIT ?= build_servers
stig-scan:
	cd ansible && ansible-playbook stig-scan.yml --limit $(LIMIT) -e openscap_report_name=$(NAME)
	gzip -9 -k -f docs/scans/$(NAME).html docs/scans/$(NAME).xml
	@echo "Rule results for $(NAME):"
	@grep -o '<result>[a-z]*</result>' docs/scans/$(NAME).xml | sed 's/<[^>]*>//g' | sort | uniq -c

# Pull IMAGE, SBOM (Syft), scan and gate (Trivy), push to the in-cluster
# registry over TLS. Outputs in build/images/; see scripts/publish-image.sh.
image:
	@test -n "$(IMAGE)" || { echo "usage: make image IMAGE=<ref>"; exit 1; }
	./scripts/publish-image.sh $(IMAGE)

# Kyverno policy tests (Kyverno CLI, offline). Cases are generated by
# tests/policies/generate.py; regenerate after editing it.
policy-test:
	kyverno test tests/policies

# --- Airgap (Week 6; docs/airgap-runbook.md) --------------------------------

# Create the rehearsal VM (8 GB, like the iMac) with a reserved address.
# Targeted, so the build node's volumes are not touched.
rehearsal:
	./scripts/vm-power.sh check $(REHEARSAL_VM)
	NODE_NAME=airgap-rehearsal NODE_MAC=$(REHEARSAL_MAC) NODE_IP=$(REHEARSAL_IP) REGISTRY_HOST= ./scripts/host-bootstrap.sh
	cd terraform && terraform init && \
	  terraform apply -auto-approve -var airgap_rehearsal=true -target=module.airgap_rehearsal
	$(MAKE) inventory AIRGAP_REHEARSAL=true

# Direct Ethernet link to the iMac (eno1; never enp3s0). share: NM shared
# (DHCP, DNS, NAT via the host's Wi-Fi) on 192.168.50.0/24. cut: keep the
# link and DHCP, drop forwarding beyond it. scripts/airgap-link.sh.
airgap-link-status:
	./scripts/airgap-link.sh status
# The iMac's NIC and its reserved address on the link.
AIRGAP_MAC  ?= ac:87:a3:35:6f:fc
AIRGAP_ADDR ?= 192.168.50.195
airgap-link-share:
	NODE_MAC=$(AIRGAP_MAC) NODE_ADDR=$(AIRGAP_ADDR) ./scripts/airgap-link.sh share
airgap-link-cut:
	./scripts/airgap-link.sh cut
airgap-link-uncut:
	./scripts/airgap-link.sh uncut

# Download everything the airgapped node needs into build/airgap/.
airgap-stage:
	./scripts/airgap-stage.sh

# Build and sign the Zarf packages (zarf/*) into build/airgap/packages/.
# Needs the build cluster's registry (sample app images and signatures).
airgap-packages:
	./scripts/airgap-packages.sh

# Base, hardening and RKE2 (from the staged artifacts) on the airgapped node.
airgap-up:
	@test -f build/airgap/SHA256SUMS || { echo "run make airgap-stage first"; exit 1; }
	cd ansible && ansible-playbook site.yml --limit airgap_servers

# Block or reopen internet egress on the airgapped node (firewalld policies).
airgap-disconnect:
	cd ansible && ansible-playbook airgap-egress.yml -e airgap_egress_state=blocked

airgap-reconnect:
	cd ansible && ansible-playbook airgap-egress.yml -e airgap_egress_state=open

# Copy Zarf and the signed packages to the node, `zarf init`, deploy.
airgap-deploy:
	@test -f build/airgap/packages/SHA256SUMS || { echo "run make airgap-packages first"; exit 1; }
	cd ansible && ansible-playbook airgap-deploy.yml

airgap-verify:
	kubectl --kubeconfig kubeconfig-airgap get nodes -o wide
	kubectl --kubeconfig kubeconfig-airgap get pods -A

# --- Recovery (Week 7; docs/recovery.md) ------------------------------------

# Local S3 store for Velero: Garage on the build host (sudo; idempotent).
backup-store:
	./scripts/backup-store.sh

# On-demand etcd snapshot, copied to build/etcd-snapshots/<host>/.
etcd-snapshot:
	cd ansible && ansible-playbook etcd-snapshot.yml --limit $(LIMIT) -e etcd_snapshot_name=$(or $(SNAPSHOT),manual)

# Restore etcd from a snapshot on the node (destructive: the cluster returns to
# the snapshot). ansible/etcd-restore.yml; docs/recovery.md.
etcd-restore:
	@test -n "$(SNAPSHOT)" || { echo "usage: make etcd-restore SNAPSHOT=<name> CONFIRM=yes [LIMIT=...]"; exit 1; }
	@test "$(CONFIRM)" = yes || { echo "refusing without CONFIRM=yes (the cluster returns to snapshot $(SNAPSHOT))"; exit 1; }
	cd ansible && ansible-playbook etcd-restore.yml --limit $(LIMIT) \
	  -e etcd_restore_snapshot=$(SNAPSHOT) -e etcd_restore_confirm=yes

# Snapshots RKE2 knows about (scheduled and on-demand).
etcd-snapshots:
	kubectl --kubeconfig kubeconfig get etcdsnapshotfiles -o custom-columns=NAME:.spec.snapshotName,CREATED:.status.creationTime,SIZE:.status.size
