[0.185, "o", "2026/11/18 15:35:26 registry.platform-lab.internal/library/busybox:1.36.1: digest: sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662 size: 9535\r\n"]
[3.0, "o", "\r\n\u001b[1;36m### 1. Compliant pod: signed image, digest-pinned, restricted, labelled, with resources\u001b[0m\r\n"]
[1.002, "o", "\u001b[1;32m$ kubectl apply -f -\u001b[0m\r\n"]
[0.143, "o", "pod/signed-app created\r\n"]
[0.004, "o", "\u001b[1;32m$ kubectl -n demo wait --for=jsonpath={.status.phase}=Succeeded pod/signed-app --timeout=120s\u001b[0m\r\n"]
[2.0, "o", "pod/signed-app condition met\r\n"]
[0.002, "o", "\u001b[1;32m$ kubectl -n demo logs signed-app\u001b[0m\r\n"]
[0.054, "o", "hello from a signed image\r\n"]
[3.0, "o", "\r\n\u001b[1;36m### 2. Same pod with an unsigned image: rejected by the signature check\u001b[0m\r\n"]
[1.003, "o", "\u001b[1;32m$ kubectl apply -f -\u001b[0m\r\n"]
[0.124, "o", "Error from server: error when creating \"STDIN\": admission webhook \"ivpol.validate.kyverno.svc-fail\" denied the request: Policy verify-platform-images failed: image is not signed with the platform-lab cosign key (pki/cosign.pub); publish it with `make image`\r\n"]
[3.0, "o", "\r\n\u001b[1;36m### 3. Upstream nginx:latest, no label, no resources: rejected\u001b[0m\r\n"]
[1.003, "o", "\u001b[1;32m$ kubectl apply -f -\u001b[0m\r\n"]
[0.116, "o", "Error from server: error when creating \"STDIN\": admission webhook \"vpol.validate.kyverno.svc-fail\" denied the request: Policy disallow-latest-tag failed: images must use a tag other than latest, or a digest: docker.io/library/nginx:latest; Policy require-labels failed: pods must carry a non-empty app.kubernetes.io/name label; Policy require-resources failed: containers must set requests.cpu, requests.memory and limits.memory: nginx; Policy restrict-image-registries failed: images must come from a trusted registry (127.0.0.1:30500/, 127.0.0.1:31999/): docker.io/library/nginx:latest\r\n"]
[3.0, "o", "\r\n\u001b[1;36m### Clean up\u001b[0m\r\n"]
[1.001, "o", "\u001b[1;32m$ kubectl delete namespace demo --wait=false\u001b[0m\r\n"]
[0.053, "o", "namespace \"demo\" deleted\r\n"]
[0.003, "x", "0"]
[4.0, "o", ""]
